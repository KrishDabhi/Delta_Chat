# ──────────────────────────────────────────────────────────────────────────────
# .env.example
# Copy this file to .env and fill in the real values.
# NEVER commit .env to git. This file (.env.example) is safe to commit.
# ──────────────────────────────────────────────────────────────────────────────

# ── LLM ───────────────────────────────────────────────────────────────────────
# Groq API key for running the Grounded Chat LLM.
# Get yours at: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Groq model to use. Must be a valid Groq-hosted model name.
# Default: llama-3.3-70b-versatile (fast, free tier available)
LLM_MODEL=llama-3.3-70b-versatile

# Temperature for LLM. Keep at 0.0 for deterministic, grounded answers.
LLM_TEMPERATURE=0.0

# ── Vector Store (Pinecone) ───────────────────────────────────────────────────
# Pinecone API key for storing and retrieving document embeddings.
# Get yours at: https://app.pinecone.io/
PINECONE_API_KEY=your_pinecone_api_key_here

# Name of the Pinecone index to use. Will be created if it does not exist.
PINECONE_INDEX_NAME=delta-chat-index

# ── Delta Engine Thresholds ───────────────────────────────────────────────────
# Minimum IoU (Intersection over Union) for two bounding boxes to be
# considered a spatial match. Range: 0.0 to 1.0
IOU_THRESHOLD=0.5

# Minimum normalized text similarity for a matched pair to be NO_CHANGE.
# Below this threshold = MODIFIED. Range: 0.0 to 1.0
TEXT_SIMILARITY_THRESHOLD=0.85

# ── Raster PDF Processing ─────────────────────────────────────────────────────
# DPI for rasterizing scanned PDF pages before OpenCV processing.
# 300 is the minimum for reliable OCR on engineering drawings.
RASTER_DPI=300

# RANSAC: max pixel distance from fitted line for a point to be an inlier.
RANSAC_RESIDUAL_THRESHOLD=2.0

# RANSAC: minimum number of sample points needed to fit a line.
RANSAC_MIN_SAMPLES=2

# RANSAC: minimum pixel length of a reconstructed line to keep it.
RANSAC_MIN_LINE_LENGTH=50

# Path to the Tesseract OCR executable.
# Linux/Mac default: tesseract
# Windows example:   C:/Program Files/Tesseract-OCR/tesseract.exe
TESSERACT_CMD=tesseract

# ── Observability ─────────────────────────────────────────────────────────────
# Log verbosity. Use DEBUG to see per-entity extraction details.
LOG_LEVEL=INFO

# Log format. Use 'json' in production, 'console' for local development.
LOG_FORMAT=console

# ── Application ───────────────────────────────────────────────────────────────
ENVIRONMENT=development

# Directory where uploaded document pairs are stored on disk.
DATA_DIR=data/samples
